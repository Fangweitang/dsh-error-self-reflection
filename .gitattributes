# 统一换行：脚本和配置一律 LF，避免 Windows 提交 CRLF 导致跨平台行为差异
* text=auto eol=lf

# 明确按文本处理
*.mjs   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Git 内部文件
.gitignore     text eol=lf
.gitattributes text eol=lf

# 二进制（若有）
*.png   binary
*.jpg   binary
*.zip   binary
